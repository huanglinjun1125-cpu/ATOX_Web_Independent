# Copy to .env.local. Development only: mail is previewed, never delivered.
ENABLE_DEV_MAIL=true
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
DB_PATH=.data/pglite
# Only enable behind a proxy that removes and sets X-Forwarded-For itself.
TRUST_PROXY=false
# Local private files; never point this into public/.
UPLOAD_PATH=.data/uploads
# Material review now requires an enabled administrator role (M009).
# Legacy EVENT_REVIEWER_EMAILS is no longer used to authorize access.
# Independent M003 preview; development only, never real payments.
ENABLE_TICKETING_PREVIEW=false
# Generate a separate random secret of at least 32 characters before enabling.
TICKETING_WEBHOOK_SECRET=

# Optional Next.js build-only directory, must stay inside this workspace.
# Use separate output for local validation without disturbing .next/dev.
# NEXT_DIST_DIR=.next-ci
# NODE_ENV is set by Next.js; do not set it here.
# ADMIN_FIXTURE_FILE is generated by Playwright; not an application setting.
